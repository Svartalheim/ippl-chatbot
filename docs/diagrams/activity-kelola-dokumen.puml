@startuml activity-kelola-dokumen
' DOC-03 (2) - Activity: Administrator Mengelola Dokumen
' Sumber: routers/admin.py, services/ingestion_service.py
title Activity - Administrator Mengelola Dokumen

|Administrator|
start
:Buka menu Kelola Dokumen;
|Frontend|
:GET /admin/documents;
|Backend|
:Validasi JWT + require_roles("Admin");
|Database|
:Ambil daftar dokumen + status;
|Frontend|
:Tampilkan tabel dokumen;
|Administrator|
switch (Pilih aksi)
case (Unggah)
  :Pilih file + klasifikasi;
  |Frontend|
  :POST /admin/documents/upload;
  |Backend|
  if (Ekstensi & tanda tangan file valid,\nukuran <= 20 MB?) then (tidak)
    :HTTP 400 + pesan;
  else (ya)
    :Hitung SHA-256;
    if (Duplikat (hash sama)?) then (ya)
      :HTTP 409 dokumen sudah ada;
    else (tidak)
      :Simpan file ke data/documents;
      |Database|
      :INSERT Document status = Memproses;
      |Backend|
      :Ekstrak teks (PDF per halaman / DOCX per bagian);
      if (Ada teks?) then (tidak)
        |Database|
        :status = Gagal + error_message;
      else (ya)
        |Backend|
        :Chunking (~500 kata, overlap 100);
        |Ollama|
        :create_embedding per chunk;
        |Database|
        :INSERT DocumentChunk\n(klasifikasi disalin dari dokumen);
        :status = Terindeks, chunk_count;
      endif
      |Backend|
      :record_audit_log(DOC_UPLOAD);
    endif
  endif
case (Ubah klasifikasi)
  |Frontend|
  :PATCH /admin/documents/{id};
  |Database|
  :UPDATE Document + semua DocumentChunk;
  |Backend|
  :record_audit_log(DOC_RECLASSIFY);
case (Hapus)
  |Administrator|
  :Konfirmasi hapus;
  |Backend|
  if (Dokumen dalam legal hold?) then (ya)
    :HTTP 423 ditolak;
  else (tidak)
    :Hapus file fisik;
    |Database|
    :DELETE Document (chunk ikut terhapus, CASCADE);
    |Backend|
    :record_audit_log(DOC_DELETE);
  endif
case (Indeks ulang semua)
  |Frontend|
  :POST /admin/documents/reindex-all;
  |Backend|
  :reindex_all_documents();
  :record_audit_log(DOC_REINDEX);
endswitch
|Frontend|
:Muat ulang tabel dokumen;
stop
@enduml
