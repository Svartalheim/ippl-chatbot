@startuml class-implementation
' ==========================================================================
' DOC-04 - Class Diagram tingkat implementasi (lapisan router & service FastAPI)
' Sumber: backend/app/main.py, routers/*.py, services/*.py, auth.py
' ==========================================================================
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "Frontend (React + TypeScript)" {
  class LoginPage <<page>>
  class ChatPage <<page>>
  class AdminDashboardPage <<page>>
  class AdminDocumentsPage <<page>>
  class AdminRolesPage <<page>>
  class AuditorLogsPage <<page>>
  class DocumentViewerModal <<component>>
  class AuthContext <<context>> {
    + login(username, password)
    + logout()
    + refresh()
  }
  class ApiClient <<module>> {
    + get(path)
    + post(path, body)
    + apiFetchBlob(path)
  }
}

package "Backend (FastAPI)" {
  class AuthRouter <<router /auth>> {
    + login()
    + refresh_token()
    + logout()
    + userinfo()
  }
  class ChatRouter <<router /chat>> {
    + list_sessions()
    + create_session()
    + delete_session()
    + get_session_messages()
    + send_chat_query()
    + submit_feedback()
    + preview_cited_document()
    + get_cited_document_file()
  }
  class AdminRouter <<router /admin>> {
    + get_dashboard_health()
    + list_documents()
    + upload_document()
    + reindex_all()
    + update_document()
    + delete_document()
    + list_roles()
    + create_role()
    + update_role()
    + list_users()
    + update_user_role()
    + terminate_sessions()
  }
  class AuditRouter <<router /audit>> {
    + list_audit_logs()
    + verify_chain()
    + export_audit_csv()
  }

  class AuthModule <<module auth.py>> {
    + decode_token(token) : dict
    + sync_user_to_db(session, user_info) : User
    + get_user_allowed_classifications(session, role) : List
    + current_user() : UserInfo
    + require_roles(*roles)
  }
  class UserInfo {
    + username : String
    + full_name : String
    + role_name : String
    + db_id : String
  }
  class RagService <<service>> {
    + check_prompt_injection(query) : bool
    + execute_rag_query(...) : dict
    - _ollama_chat(system, user) : str
    - _renumber_citations(answer, rows)
  }
  class IngestionService <<service>> {
    + validate_upload(filename, bytes)
    + ingest_document(...) : Document
    + process_document_file(...)
    + extract_and_chunk_document(...)
    + create_embedding(text, kind) : List<float>
    + reindex_all_documents(session)
  }
  class AuditService <<service>> {
    + record_audit_log(...) : AuditLog
    + verify_audit_chain(session) : dict
  }
  class PiiService <<service>> {
    + redact_pii(text) : str
  }
  class SecurityService <<service>> {
    + check_security_alert(session, ...)
  }
}

package "Infrastruktur" {
  class Keycloak <<external>>
  class Ollama <<external>>
  class "PostgreSQL + pgvector" as PG <<database>>
}

LoginPage ..> AuthContext
ChatPage ..> ApiClient
ChatPage ..> DocumentViewerModal
AdminDocumentsPage ..> DocumentViewerModal
AdminDashboardPage ..> ApiClient
AdminRolesPage ..> ApiClient
AuditorLogsPage ..> ApiClient
AuthContext ..> ApiClient
ApiClient ..> AuthRouter : HTTPS/JSON
ApiClient ..> ChatRouter
ApiClient ..> AdminRouter
ApiClient ..> AuditRouter

AuthRouter ..> AuthModule
AuthRouter ..> Keycloak : OIDC token / logout
ChatRouter ..> AuthModule
ChatRouter ..> RagService
AdminRouter ..> AuthModule
AdminRouter ..> IngestionService
AuditRouter ..> AuditService
AuthModule ..> UserInfo
AuthModule ..> Keycloak : JWKS

RagService ..> IngestionService : create_embedding
RagService ..> AuditService
RagService ..> PiiService
RagService ..> SecurityService
RagService ..> Ollama : /api/chat
IngestionService ..> Ollama : /api/embeddings
IngestionService ..> PG
AuditService ..> PG
AuthRouter ..> AuditService
AdminRouter ..> AuditService
SecurityService ..> AuditService
@enduml
