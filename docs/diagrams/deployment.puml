@startuml deployment
' DOC-07 - Deployment: kondisi saat ini (Docker Compose) dan target produksi
title Deployment - Saat Ini (Docker Compose, pengembangan)

node "Docker host" {
  node "frontend\n(nginx, :443 / :80)" as RP
  node "frontend-dev\n(Vite :5173)" as FE
  node "backend\n(FastAPI/uvicorn :8000)" as BE
  node "keycloak 26.0\n(:8080)" as KC
  database "postgres pgvector pg16\n(:5432, ssl=on)" as PG
  node "ollama\n(:11434)\nllama3.2:3b, nomic-embed-text" as OL
  node "backup\n(pg_dump terjadwal)" as BK
  storage "volume: postgres data" as V1
  storage "volume: ollama_data" as V2
  storage "bind: data/documents" as V3
  storage "bind: backups/" as V4
}
actor Browser

Browser --> RP : HTTPS (TLS 1.2/1.3)
RP --> FE : HTTP (internal)
RP --> BE : /api -> HTTP (internal)
Browser --> KC : OIDC (melalui proxy)
BE --> KC : token / JWKS
BE --> PG : asyncpg (sslmode=require)
BE --> OL : HTTP /api/chat, /api/embeddings
KC --> PG : JDBC
PG -- V1
OL -- V2
BE -- V3
BK --> PG : pg_dump
BK -- V4
BK -- V3

newpage
title Deployment - Target Produksi (cloud)

cloud "Internet" {
  actor Pengguna
}
node "Load balancer / reverse proxy\n(TLS 1.3, WAF)" as LB
node "Kluster aplikasi (privat)" {
  node "frontend (statis)" as FE2
  node "backend replika 1..N\n(stateless, gunicorn workers)" as BE2
  node "keycloak (HA)" as KC2
}
node "Node GPU (privat)" {
  node "ollama" as OL2
}
database "Managed PostgreSQL + pgvector\nenkripsi at rest AES-256 (KMS/CMEK)\nbackup otomatis + PITR" as PG2
storage "Object storage terenkripsi\n(file dokumen)" as OS2

Pengguna --> LB : HTTPS
LB --> FE2
LB --> BE2
LB --> KC2
BE2 --> PG2 : TLS + IAM/secret
BE2 --> OL2 : jaringan internal
BE2 --> OS2 : TLS
KC2 --> PG2 : TLS
@enduml
