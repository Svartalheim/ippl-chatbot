@startuml erd
' DOC-06 - ERD, sumber: infra/postgres/init.sql
title ERD - Sistem Chatbot Cerdas & Aman
hide circle
skinparam linetype ortho

entity roles {
  * id : SERIAL <<PK>>
  --
  * name : VARCHAR(50) <<UNIQUE>>
  description : TEXT
  * allowed_classifications : TEXT[]
  * can_manage_docs : BOOLEAN
  * can_manage_rbac : BOOLEAN
  * can_view_audit : BOOLEAN
  * created_at : TIMESTAMPTZ
}

entity users {
  * id : UUID <<PK>>
  --
  * keycloak_sub : VARCHAR(255) <<UNIQUE>>
  * username : VARCHAR(100) <<UNIQUE>>
  full_name : VARCHAR(255)
  email : VARCHAR(255)
  role_id : INT <<FK roles, SET NULL>>
  * is_active : BOOLEAN
  last_login_at : TIMESTAMPTZ
  * created_at : TIMESTAMPTZ
}

entity documents {
  * id : UUID <<PK>>
  --
  * filename : VARCHAR(255)
  * file_type : VARCHAR(50)
  * file_size_bytes : BIGINT
  sha256 : VARCHAR(64)
  * classification : VARCHAR(20) <<CHECK Public|HR|Finance|Legal|Confidential>>
  * legal_hold : BOOLEAN
  * status : VARCHAR(20) <<CHECK Terindeks|Memproses|Gagal>>
  error_message : TEXT
  * chunk_count : INT
  uploaded_by : UUID <<FK users, SET NULL>>
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity document_chunks {
  * id : UUID <<PK>>
  --
  * document_id : UUID <<FK documents, CASCADE>>
  * chunk_index : INT
  * content : TEXT
  page_number : INT
  section_title : TEXT
  * classification : VARCHAR(20)
  embedding : vector(768) <<HNSW cosine>>
  * metadata_json : JSONB
  * created_at : TIMESTAMPTZ
}

entity chat_sessions {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK users, CASCADE>>
  * title : TEXT
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity chat_messages {
  * id : UUID <<PK>>
  --
  * session_id : UUID <<FK chat_sessions, CASCADE>>
  * sender : VARCHAR(10) <<CHECK user|assistant>>
  * content : TEXT
  * status : VARCHAR(20) <<CHECK SUCCESS|QUERY_DENIED|PROMPT_INJECTION|ERROR>>
  blocked_classification : VARCHAR(20)
  * citations_json : JSONB
  latency_ms : INT
  * created_at : TIMESTAMPTZ
}

entity feedbacks {
  * id : UUID <<PK>>
  --
  * message_id : UUID <<FK chat_messages, CASCADE, UNIQUE>>
  user_id : UUID <<FK users, SET NULL>>
  * is_positive : BOOLEAN
  comment : TEXT
  * created_at : TIMESTAMPTZ
}

entity audit_logs {
  * id : BIGSERIAL <<PK>>
  --
  * created_at : TIMESTAMPTZ
  actor_user_id : UUID <<FK users, SET NULL>>
  * actor_name : TEXT
  * actor_role : TEXT
  ip_address : TEXT
  * action : TEXT
  detail : TEXT
  * status : VARCHAR(20) <<CHECK Berhasil|Ditolak RBAC|Diblokir|Gagal>>
  * prev_hash : TEXT
  * curr_hash : TEXT
}

roles ||--o{ users
users |o--o{ documents
documents ||--o{ document_chunks
users ||--o{ chat_sessions
chat_sessions ||--o{ chat_messages
chat_messages ||--o| feedbacks
users |o--o{ feedbacks
users |o--o{ audit_logs

note bottom of audit_logs
  Trigger trg_prevent_audit_log_modification menolak UPDATE/DELETE;
  trg_prevent_audit_log_truncate menolak TRUNCATE.
  curr_hash = SHA-256(prev_hash|created_at|actor|role|action|detail|status).
end note
@enduml
