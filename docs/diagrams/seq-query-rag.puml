@startuml seq-query-rag
' DOC-05 (2) - Sequence: Mengajukan Pertanyaan (RAG)
title Sequence - Mengajukan Pertanyaan
actor Pengguna
participant "ChatPage" as FE
participant "ChatRouter\nsend_chat_query" as CR
participant "auth.py" as AM
participant "RagService" as RS
participant "PiiService" as PII
participant "IngestionService" as IS
participant "Ollama" as OL
database "PostgreSQL\n+ pgvector" as DB
participant "AuditService" as AS

Pengguna -> FE : ketik pertanyaan, kirim
FE -> CR : POST /chat/sessions/{id}/query
CR -> AM : current_user (validasi JWT)
CR -> AM : get_user_allowed_classifications(role)
CR -> RS : execute_rag_query(query, allowed, ...)
RS -> RS : check_prompt_injection(query)
alt injeksi terdeteksi
  RS -> AS : record_audit_log(PROMPT_INJECTION, Diblokir)
else small talk / daftar dokumen
  RS -> RS : jawaban canned / daftar dokumen diizinkan
else pertanyaan dokumen
  RS -> IS : create_embedding(query, "query")
  IS -> OL : POST /api/embeddings
  OL --> IS : vektor 768-d
  RS -> DB : top-K WHERE classification = ANY(allowed)
  RS -> DB : top-1 global (hanya skor)
  alt hanya dokumen tak berizin yang relevan
    RS -> AS : record_audit_log(QUERY_DENIED, Ditolak RBAC)
  else ada konteks relevan
    RS -> OL : POST /api/chat (prompt sistem + konteks + kueri)
    OL --> RS : jawaban
    RS -> RS : _renumber_citations
  else tidak relevan / LLM gagal
    RS -> RS : _no_answer_result / _error_result
  end
  RS -> PII : redact_pii(query)
  RS -> AS : record_audit_log(QUERY, detail: kueri + chunk_ids)
end
AS -> DB : INSERT audit_logs
RS --> CR : {answer, status, citations, latency_ms}
CR -> DB : INSERT chat_messages (user + assistant)
CR --> FE : ChatMessageResponse
FE --> Pengguna : jawaban + sitasi
@enduml
