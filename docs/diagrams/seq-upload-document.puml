@startuml seq-upload-document
' DOC-05 (3) - Sequence: Unggah Dokumen
title Sequence - Unggah Dokumen
actor Administrator
participant "AdminDocumentsPage" as FE
participant "AdminRouter\nupload_document" as AR
participant "IngestionService" as IS
participant "Ollama" as OL
database "PostgreSQL\n+ pgvector" as DB
participant "Penyimpanan\ndata/documents" as FS
participant "AuditService" as AS

Administrator -> FE : pilih file + klasifikasi
FE -> AR : POST /admin/documents/upload (multipart)
AR -> AR : require_roles("Admin")
AR -> IS : validate_upload(filename, bytes)
alt tidak valid (ekstensi/tanda tangan/ukuran/duplikat)
  IS --> AR : ValueError
  AR --> FE : 400 / 409
else valid
  AR -> IS : ingest_document(...)
  IS -> DB : INSERT documents (Memproses, sha256)
  IS -> FS : simpan file
  IS -> IS : extract_and_chunk_document
  loop setiap chunk
    IS -> OL : POST /api/embeddings
    OL --> IS : vektor
  end
  IS -> DB : INSERT document_chunks (klasifikasi)
  IS -> DB : UPDATE documents (Terindeks / Gagal)
  IS --> AR : Document
  AR -> AS : record_audit_log(DOC_UPLOAD)
  AR --> FE : DocumentResponse
end
@enduml
